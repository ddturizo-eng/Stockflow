<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="1400.0" prefWidth="1300.0" spacing="12.0" style="-fx-background-color: #eceff4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.VentaController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <VBox spacing="3.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Nueva Venta" textFill="#2e3440">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label text="Registra una nueva transacción de venta" textFill="#4c566a">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <VBox alignment="TOP_RIGHT" spacing="8.0">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Label text="Código" textFill="#4c566a">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtCodigoVenta" editable="false" prefWidth="110.0" style="-fx-background-color: #e5e9f0; -fx-border-color: transparent; -fx-font-weight: bold;" text="V-001">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_RIGHT" spacing="12.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="36.0" text="Fecha" textFill="#4c566a">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtFecha" editable="false" prefHeight="30.0" prefWidth="128.0" style="-fx-background-color: #e5e9f0; -fx-border-color: transparent;">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox spacing="14.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Cliente" textFill="#2e3440">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblClienteSeleccionado" style="-fx-background-color: #d8dee9; -fx-padding: 6 14 6 14;" text="Sin seleccionar" textFill="#4c566a">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <TextField fx:id="txtBuscarCliente" prefHeight="40.0" promptText="Buscar cliente por cédula, nombre o teléfono" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5; -fx-prompt-text-fill: #a0a8b5;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </TextField>
                  
                  <Button fx:id="btnRefrescarClientes" mnemonicParsing="false" onAction="#refrescarClientes" prefHeight="40.0" prefWidth="105.0" style="-fx-background-color: #2D4C96; -fx-text-fill: white; -fx-cursor: hand;" text="Refrescar">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Button>
                  
                  <Button fx:id="btnNuevoCliente" mnemonicParsing="false" onAction="#mostrarFormularioCliente" prefHeight="40.0" prefWidth="145.0" style="-fx-background-color: #2D4C96; -fx-text-fill: white; -fx-cursor: hand;" text="Agregar Cliente">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Lista de clientes" textFill="#4c566a">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblTotalClientes" style="-fx-background-color: #ebcb8b; -fx-padding: 3 10 3 10; -fx-text-fill: white;" text="0">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            
            <TableView fx:id="tablaClientes" prefHeight="320.0" style="-fx-border-color: #e5e9f0; -fx-border-width: 1;">
               <columns>
                  <TableColumn fx:id="colClienteCedula" minWidth="110.0" prefWidth="110.0" text="Cédula" />
                  <TableColumn fx:id="colClienteNombre" minWidth="280.0" prefWidth="320.0" text="Nombre Completo" />
                  <TableColumn fx:id="colClienteTelefono" minWidth="130.0" prefWidth="160.0" text="Teléfono" />
                  <TableColumn fx:id="colClienteEmail" minWidth="220.0" prefWidth="260.0" text="Correo Electrónico" />
                  <TableColumn fx:id="colClienteSeleccionar" minWidth="110.0" prefWidth="130.0" text="Acción" />
               </columns>
            </TableView>
         </children>
      </VBox>
      <VBox spacing="14.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <Label text="Productos" textFill="#2e3440">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <TextField fx:id="txtBuscarProducto" prefHeight="40.0" promptText="Código, nombre o categoría del producto" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5; -fx-prompt-text-fill: #a0a8b5;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </TextField>
                  
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Cant." textFill="#4c566a">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtCantidad" alignment="CENTER" prefHeight="40.0" prefWidth="65.0" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5;" text="1">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <VBox spacing="4.0">
                     <children>
                        <Label text="Desc." textFill="#4c566a">
                           <font>
                              <Font size="11.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtDescuento" alignment="CENTER" prefHeight="40.0" prefWidth="70.0" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5;" text="0">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <Button fx:id="btnRefrescarProductos" mnemonicParsing="false" onAction="#refrescarProductos" prefHeight="40.0" prefWidth="105.0" style="-fx-background-color: #2D4C96; -fx-text-fill: white; -fx-cursor: hand;" text="Refrescar">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label text="Inventario disponible" textFill="#4c566a">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblTotalProductos" style="-fx-background-color: #a3be8c; -fx-padding: 3 10 3 10; -fx-text-fill: white;" text="0">
                     <font>
                        <Font name="System Bold" size="11.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            
            <TableView fx:id="tablaProductos" prefHeight="280.0" style="-fx-border-color: #e5e9f0; -fx-border-width: 1;">
               <columns>
                  <TableColumn fx:id="colProductoCodigo" minWidth="100.0" prefWidth="110.0" text="Código" />
                  <TableColumn fx:id="colProductoNombre" minWidth="320.0" prefWidth="400.0" text="Nombre del Producto" />
                  <TableColumn fx:id="colProductoCategoria" minWidth="160.0" prefWidth="190.0" text="Categoría" />
                  <TableColumn fx:id="colProductoPrecio" minWidth="110.0" prefWidth="140.0" text="Precio" />
                  <TableColumn fx:id="colProductoStock" minWidth="80.0" prefWidth="100.0" text="Stock" />
                  <TableColumn fx:id="colProductoAgregar" minWidth="110.0" prefWidth="130.0" text="Acción" />
               </columns>
            </TableView>
         </children>
      </VBox>
      <VBox spacing="12.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Detalle de Venta" textFill="#2e3440">
                     <font>
                        <Font name="System Bold" size="15.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#eliminarProductoSeleccionado" prefHeight="36.0" style="-fx-background-color: #C42929; -fx-text-fill: white; -fx-cursor: hand;" text="Quitar Seleccionado">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            
            <TableView fx:id="tblDetalleVenta" prefHeight="240.0" style="-fx-border-color: #e5e9f0; -fx-border-width: 1;">
              <columns>
                <TableColumn fx:id="colNumero" minWidth="50.0" prefWidth="50.0" text="No." />
                <TableColumn fx:id="colProducto" minWidth="300.0" prefWidth="380.0" text="Producto" />
                  <TableColumn fx:id="colCantidad" minWidth="100.0" prefWidth="120.0" text="Cantidad" />
                  <TableColumn fx:id="colPrecioUnitario" minWidth="130.0" prefWidth="150.0" text="Precio Unitario" />
                  <TableColumn fx:id="colDescuento" minWidth="100.0" prefWidth="120.0" text="Descuento" />
                  <TableColumn fx:id="colSubtotal" minWidth="140.0" prefWidth="180.0" text="Subtotal" />
              </columns>
            </TableView>
         </children>
      </VBox>
      <HBox spacing="12.0">
         <children>
            <VBox spacing="14.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Método de Pago" textFill="#2e3440">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <VBox spacing="10.0">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Forma de pago" textFill="#4c566a">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <ComboBox fx:id="cmbMetodoPago" prefHeight="38.0" prefWidth="200.0" promptText="Seleccionar" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5;" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="6.0">
                                 <children>
                                    <Label text="Monto recibido" textFill="#4c566a">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <TextField fx:id="txtMontoRecibido" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5;">
                                       <font>
                                          <Font size="13.0" />
                                       </font>
                                    </TextField>
                                 </children>
                              </VBox>
                              
                              <VBox spacing="6.0">
                                 <children>
                                    <Label text="Cambio" textFill="#4c566a">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <TextField fx:id="txtCambio" editable="false" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #e5e9f0; -fx-border-color: transparent;">
                                       <font>
                                          <Font size="13.0" />
                                       </font>
                                    </TextField>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox spacing="14.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 2);">
               <padding>
                  <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
               </padding>
               <children>
                  <Label text="Resumen" textFill="#2e3440">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <VBox spacing="12.0">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <Label prefWidth="110.0" text="Subtotal" textFill="#4c566a">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblSubtotal" text="COP 0" textFill="#2e3440">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <Label prefWidth="110.0" text="Descuento" textFill="#4c566a">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblDescuentoTotal" text="COP 0" textFill="#bf616a">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" spacing="20.0">
                           <children>
                              <Label prefWidth="110.0" text="IVA" textFill="#4c566a">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtIVA" alignment="CENTER" prefHeight="32.0" prefWidth="50.0" style="-fx-background-color: #f8f9fb; -fx-border-color: #d8dee9; -fx-border-width: 1.5;" text="0">
                                 <font>
                                    <Font size="12.0" />
                                 </font>
                              </TextField>
                              <Label fx:id="lblIVA" text="COP 0" textFill="#5e81ac">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                        
                        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #eceff4; -fx-padding: 12;">
                           <children>
                              <Label prefWidth="110.0" text="TOTAL" textFill="#2e3440">
                                 <font>
                                    <Font name="System Bold" size="13.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblTotalPagar" text="COP 0" textFill="#5e81ac">
                                 <font>
                                    <Font name="System Bold" size="19.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <padding>
            <Insets top="8.0" />
         </padding>
         <children>
            <Button fx:id="btnCancelarVenta" prefHeight="44.0" prefWidth="160.0" style="-fx-background-color: #d8dee9; -fx-text-fill: #4c566a; -fx-cursor: hand;" text="Cancelar">
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
            <Button fx:id="btnGuardarVenta" onAction="#guardarVenta" prefHeight="44.0" prefWidth="220.0" style="-fx-background-color: #5e81ac; -fx-text-fill: white; -fx-cursor: hand;" text="GUARDAR Y FACTURAR">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
