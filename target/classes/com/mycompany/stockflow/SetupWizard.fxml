<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.mycompany.stockflow.SetupWizardController"
      prefWidth="550" prefHeight="650" 
      style="-fx-background-color: white; -fx-padding: 40;">
    
    <!-- HEADER -->
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 0 0 30 0;">
        <Label text="🚀" style="-fx-font-size: 48;"/>
        <Label fx:id="lblTitulo" text="¡Bienvenido a StockFlow!" 
               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label fx:id="lblDescripcion" text="Configuración inicial del sistema" 
               style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;" wrapText="true" alignment="CENTER"/>
    </VBox>
    
    <Separator VBox.margin="$x1">
        <VBox.margin>
            <Insets bottom="30"/>
        </VBox.margin>
    </Separator>
    
    <!-- Instrucciones -->
    <VBox spacing="8" style="-fx-background-color: #e3f2fd; -fx-padding: 15; -fx-background-radius: 8;">
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>
        <Label text="📋 Instrucciones:" 
               style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1976d2;"/>
        <Label text="• Crea tu cuenta de administrador para gestionar el sistema" 
               style="-fx-font-size: 12; -fx-text-fill: #424242;" wrapText="true"/>
        <Label text="• Esta será la cuenta principal con acceso completo" 
               style="-fx-font-size: 12; -fx-text-fill: #424242;" wrapText="true"/>
        <Label text="• Recuerda guardar tus credenciales de forma segura" 
               style="-fx-font-size: 12; -fx-text-fill: #424242;" wrapText="true"/>
    </VBox>
    
    <!-- FORMULARIO -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" 
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox spacing="18">
            
            <!-- Nombre de Usuario -->
            <VBox spacing="6">
                <Label text="Nombre de Usuario *" 
                       style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #34495e;"/>
                <TextField fx:id="txtUsername" promptText="Ej: Danieltur"
                           style="-fx-padding: 12; -fx-background-radius: 5; -fx-border-color: #bdc3c7; 
                                  -fx-border-radius: 5; -fx-font-size: 13;"/>
                <Label text="Mínimo 3 caracteres, sin espacios" 
                       style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
            </VBox>
            
            <!-- Contraseña -->
            <VBox spacing="6">
                <Label text="Contraseña *" 
                       style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="txtPassword" promptText="Mínimo 4 caracteres"
                               style="-fx-padding: 12; -fx-background-radius: 5; -fx-border-color: #bdc3c7; 
                                      -fx-border-radius: 5; -fx-font-size: 13;"/>
            </VBox>
            
            <!-- Confirmar Contraseña -->
            <VBox spacing="6">
                <Label text="Confirmar Contraseña *" 
                       style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #34495e;"/>
                <PasswordField fx:id="txtConfirmarPassword" promptText="Repita la contraseña"
                               style="-fx-padding: 12; -fx-background-radius: 5; -fx-border-color: #bdc3c7; 
                                      -fx-border-radius: 5; -fx-font-size: 13;"/>
            </VBox>
            
            <!-- Nombre Completo -->
            <VBox spacing="6">
                <Label text="Nombre Completo *" 
                       style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #34495e;"/>
                <TextField fx:id="txtNombreCompleto" promptText="Ej: Daniel Turizo"
                           style="-fx-padding: 12; -fx-background-radius: 5; -fx-border-color: #bdc3c7; 
                                  -fx-border-radius: 5; -fx-font-size: 13;"/>
            </VBox>
            
            <!-- Email -->
            <VBox spacing="6">
                <Label text="Email (opcional)" 
                       style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #34495e;"/>
                <TextField fx:id="txtEmail" promptText="Ej: daniel@stockflow.com"
                           style="-fx-padding: 12; -fx-background-radius: 5; -fx-border-color: #bdc3c7; 
                                  -fx-border-radius: 5; -fx-font-size: 13;"/>
            </VBox>
            
        </VBox>
    </ScrollPane>
    
    <Separator VBox.margin="$x1">
        <VBox.margin>
            <Insets top="25" bottom="25"/>
        </VBox.margin>
    </Separator>
    
    <!-- BOTONES -->
    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="btnCancelar" text="Cancelar" onAction="#handleCancelar" 
                prefWidth="140" prefHeight="45"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14; 
                       -fx-background-radius: 8; -fx-cursor: hand;"/>
        
        <Button fx:id="btnCrear" text="CREAR ADMINISTRADOR" onAction="#handleCrear" 
                prefWidth="280" prefHeight="45"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14; 
                       -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(33, 150, 243, 0.5), 10, 0.4, 0, 3);"/>
    </HBox>
    
    <!-- Nota de seguridad -->
    <HBox alignment="CENTER" spacing="8" style="-fx-padding: 20 0 0 0;">
        <Label text="🔒" style="-fx-font-size: 14;"/>
        <Label text="Conexión segura - Tus datos están protegidos" 
               style="-fx-font-size: 11; -fx-text-fill: #95a5a6;"/>
    </HBox>
    
</VBox>