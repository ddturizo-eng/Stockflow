            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnCopiarMetricas" onAction="#handleCopiarMetricas" style="-fx-background-color: #EFF6FF; -fx-text-fill: #3B82F6; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 8 16;" text="📋 Copiar" />
            <Button fx:id="btnGuardarMetricas" onAction="#handleGuardarMetricas" style="-fx-background-color: #F0FDF4; -fx-text-fill: #10B981; -fx-font-size: 12px; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 8 16;" text="💾 Guardar" />
        </HBox>
        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
