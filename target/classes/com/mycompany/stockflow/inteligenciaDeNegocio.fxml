<BorderPane prefHeight="900.0" prefWidth="1600.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.InteligenciaNegocioController">
 
