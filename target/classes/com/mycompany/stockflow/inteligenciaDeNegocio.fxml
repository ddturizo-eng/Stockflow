<Tab closable="false" text=" Métricas">
    <VBox spacing="12" style="-fx-background-color: #F8FAFC;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 16; -fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-border-width: 1;">
