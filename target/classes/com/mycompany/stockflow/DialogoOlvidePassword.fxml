<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400" prefWidth="500" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.DialogoOlvidePasswordController">
    
    <!-- HEADER -->
    <VBox style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets bottom="20" left="28" right="28" top="24" />
        </padding>
        
        <VBox spacing="4">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Recuperar Contraseña" />
            <Label style="-fx-font-size: 13; -fx-text-fill: #64748b;" text="Solicita un cambio de contraseña al administrador" />
        </VBox>
    </VBox>
    
    <!-- CONTENIDO -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="24" left="28" right="28" top="24" />
        </padding>
        
        <!-- Paso 1: Buscar Usuario -->
        <VBox spacing="8">
            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Ingresa tu nombre de usuario" />
            <HBox spacing="8">
                <TextField fx:id="txtUsuario" prefHeight="40" promptText="Ej: danieltur" style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnBuscar" onAction="#handleBuscar" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;" text="Buscar" />
            </HBox>
        </VBox>
        
        <!-- Estado -->
        <Label fx:id="lblEstado" style="-fx-font-size: 12; -fx-text-fill: #64748b;" text="Ingresa tu nombre de usuario" />
        
        <!-- Paso 2: Datos encontrados -->
        <VBox fx:id="vboxDatos" spacing="12" style="-fx-padding: 16; -fx-background-color: #f1f5f9; -fx-background-radius: 8;" visible="false">
            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Usuario encontrado:" />
            
            <VBox spacing="4" style="-fx-padding: 12; -fx-background-color: white; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
                <Label style="-fx-font-size: 11; -fx-text-fill: #64748b;" text="Nombre:" />
                <Label fx:id="lblUsuarioEncontrado" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Nombre del usuario" />
                
                <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-padding: 8 0 0 0;" text="Email registrado:" />
                <Label fx:id="lblEmailUsuario" style="-fx-font-size: 14; -fx-text-fill: #2563eb;" text="Email" />
            </VBox>
            
            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Selecciona cómo deseas enviar la solicitud:" />
            
            <!-- Botones de envío -->
            <HBox spacing="8">
                <Button fx:id="btnEnviarEmail" onAction="#handleEnviarEmail" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12;" text="Enviar por Email" HBox.hgrow="ALWAYS" />
                
        
            </HBox>
        </VBox>
    </VBox>
    
    <!-- BOTONES INFERIORES -->
    <VBox style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets bottom="20" left="28" right="28" top="20" />
            </padding>
            
            <Button fx:id="btnCancelar" onAction="#handleCancelar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;" text="Cancelar" />
        </HBox>
    </VBox>
    
</VBox>
