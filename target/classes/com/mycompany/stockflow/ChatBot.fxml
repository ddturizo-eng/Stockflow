    </BorderPane>
    
    <StackPane fx:id="chatModalContainer" style="-fx-background-color: rgba(0, 0, 0, 0.5);" visible="false">
        <VBox spacing="0.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-max-width: 700; -fx-max-height: 800; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 4);">
            
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 20; -fx-background-color: #0066cc; -fx-background-radius: 16 16 0 0;">
                <Label style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 16;" text="ASISTENTE IA" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblEstadoIAChat" style="-fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 600; -fx-padding: 5 12; -fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12;" text="Online" />
                <Button fx:id="btnCerrarChat" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 20; -fx-cursor: hand; -fx-padding: 0; -fx-min-width: 30; -fx-min-height: 30;" text="X" />
            </HBox>
            
            <ScrollPane fx:id="scrollPaneChat" fitToWidth="true" prefHeight="550" style="-fx-background-color: #f8f9fa; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="chatContainer" spacing="16.0" style="-fx-padding: 20; -fx-background-color: #f8f9fa;" />
            </ScrollPane>
            
            <HBox alignment="CENTER" spacing="8.0" style="-fx-padding: 12 20;">
                <Label style="-fx-text-fill: #6c757d; -fx-font-size: 11;" text="Rapido:" />
                <Button fx:id="btnCmdVentasSemanal" style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-font-size: 11; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Ventas" />
                <Button fx:id="btnCmdInventario" style="-fx-background-color: #e9ecef; -fx-text-fill: #495057; -fx-font-size: 11; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Inventario" />
                <Button fx:id="btnCmdSugerencia" style="-fx-background-color: #e7f3ff; -fx-text-fill: #0066cc; -fx-font-size: 11; -fx-font-weight: 600; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Sugerencia" />
            </HBox>
            
            <HBox spacing="12.0" style="-fx-padding: 16 20 20 20; -fx-background-color: #ffffff; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;">
                <TextField fx:id="txtInputUsuario" promptText="Pregunta lo que necesites" style="-fx-background-color: #f8f9fa; -fx-text-fill: #212529; -fx-prompt-text-fill: #adb5bd; -fx-font-size: 14; -fx-padding: 14 16; -fx-background-radius: 10; -fx-border-color: #dee2e6; -fx-border-radius: 10; -fx-border-width: 1;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnEnviarChat" style="-fx-background-color: #0066cc; -fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 14; -fx-min-width: 80; -fx-min-height: 50; -fx-background-radius: 10; -fx-cursor: hand;" text="ENVIAR" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
