<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.FacturacionController">
   <content>
      <VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="938.0" spacing="15.0" style="-fx-background-color: #F5F7FA;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestión de Facturación" />
            
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #BDC3C7; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Filtros de Búsqueda" />
                  
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: #2C3E50;" text="Número Comprobante" />
                              <TextField fx:id="txtBuscarNumero" prefWidth="150.0" promptText="COMP-001" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: #2C3E50;" text="Cliente" />
                              <TextField fx:id="txtBuscarCliente" prefWidth="200.0" promptText="Nombre del cliente" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: #2C3E50;" text="Estado" />
                              <ComboBox fx:id="cmbEstado" prefWidth="120.0" promptText="Todos" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0" alignment="BOTTOM_LEFT">
                           <children>
                              <Button onAction="#buscarFacturas" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Buscar">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Button>
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0" alignment="BOTTOM_LEFT">
                           <children>
                              <Button onAction="#limpiarFiltros" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Limpiar" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Lista de Comprobantes" />
            
            <TableView fx:id="tblFacturas" prefHeight="350.0" prefWidth="900.0">
              <columns>
                <TableColumn fx:id="colNumero" prefWidth="100.0" text="Nro. Comprobante" />
                <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                <TableColumn fx:id="colCliente" prefWidth="200.0" text="Cliente" />
                <TableColumn fx:id="colCedula" prefWidth="100.0" text="Cédula" />
                <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
                <TableColumn fx:id="colMetodoPago" prefWidth="100.0" text="Método Pago" />
                <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
              </columns>
            </TableView>
            
            <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Total de comprobantes:" />
                  <Label fx:id="lblTotalComprobantes" style="-fx-text-fill: #27AE60; -fx-font-weight: bold;" text="0" />
                  
                  <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-padding: 0 0 0 20;" text="Total facturado:" />
                  <Label fx:id="lblTotalFacturado" style="-fx-text-fill: #27AE60; -fx-font-weight: bold;" text="\$0.00" />
               </children>
            </HBox>
            
            <HBox spacing="15.0" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button onAction="#verDetalleFactura" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20;" text="Ver Detalle">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  
                  <Button onAction="#imprimirFactura" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20;" text="Imprimir / PDF">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  
                  <Button onAction="#anularFactura" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20;" text="Anular Factura">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  
                  <Button onAction="#actualizarLista" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 20;" text="Actualizar Lista" />
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>