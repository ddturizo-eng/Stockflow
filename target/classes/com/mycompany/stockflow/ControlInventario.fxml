<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.ControlInventarioController">
   <content>
      <VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="938.0" spacing="15.0" style="-fx-background-color: #F5F7FA;">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Control de Inventario" />
            
            <!-- TABLA DE ALERTAS AMPLIADA 100% -->
            <VBox prefHeight="200.0" prefWidth="898.0" spacing="10.0" style="-fx-background-color: #FFEBEE; -fx-padding: 15; -fx-border-color: #E74C3C; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #C62828;" text="⚠ Alertas de Stock Bajo" />
                        <Label fx:id="lblCantidadAlertas" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #E74C3C; -fx-padding: 2 8; -fx-background-radius: 10;" text="0" />
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tblProductosStockBajo" prefHeight="150.0" minHeight="100.0" prefWidth="866.0" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colAlertaCodigo" minWidth="80.0" prefWidth="100.0" text="Código" />
                      <TableColumn fx:id="colAlertaProducto" minWidth="250.0" prefWidth="350.0" text="Producto" />
                      <TableColumn fx:id="colAlertaStock" minWidth="100.0" prefWidth="120.0" text="Stock Actual" />
                      <TableColumn fx:id="colAlertaMinimo" minWidth="100.0" prefWidth="120.0" text="Stock Mínimo" />
                      <TableColumn fx:id="colAlertaEstado" minWidth="120.0" prefWidth="160.0" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #BDC3C7; -fx-border-radius: 5; -fx-background-radius: 5;">
               <children>
                  <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Registrar Movimiento de Inventario" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Tipo de Movimiento" />
                              <ComboBox fx:id="cmbTipoMovimiento" prefWidth="150.0" promptText="Seleccione" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Producto" />
                              <ComboBox fx:id="cmbProducto" prefWidth="300.0" promptText="Seleccione un producto" />
                           </children>
                        </VBox>
                        
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Cantidad" />
                              <TextField fx:id="txtCantidad" prefWidth="100.0" promptText="0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Motivo / Observación" />
                        <TextField fx:id="txtMotivo" prefWidth="650.0" promptText="Ej: Compra a proveedor, Corrección de inventario, etc." />
                     </children>
                  </VBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 10 0 0 0;">
                     <children>
                        <Label fx:id="lblStockActual" style="-fx-text-fill: #34495E;" text="Stock actual: --" />
                        <Label fx:id="lblStockNuevo" style="-fx-text-fill: #27AE60; -fx-font-weight: bold;" text="Nuevo stock: --" />
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Button onAction="#registrarMovimiento" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20;" text="Registrar Movimiento">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                        
                        <Button onAction="#limpiarFormulario" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 20;" text="Limpiar" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Historial de Movimientos Recientes" />
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label style="-fx-text-fill: #2C3E50;" text="Buscar por producto" />
                        <TextField fx:id="txtBuscarProducto" prefWidth="250.0" promptText="Código o nombre del producto" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label style="-fx-text-fill: #2C3E50;" text="Filtrar por tipo" />
                        <ComboBox fx:id="cmbFiltroTipo" prefWidth="150.0" promptText="Todos" />
                     </children>
                  </VBox>
                  
                  <VBox alignment="BOTTOM_LEFT" spacing="5.0">
                     <children>
                        <Button onAction="#buscarMovimientos" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Buscar" />
                     </children>
                  </VBox>
                  
                  <VBox alignment="BOTTOM_LEFT" spacing="5.0">
                     <children>
                        <Button onAction="#actualizarHistorial" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Actualizar" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <TableView fx:id="tblMovimientos" prefHeight="200.0" prefWidth="900.0">
              <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha" />
                <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                <TableColumn fx:id="colProducto" prefWidth="250.0" text="Producto" />
                <TableColumn fx:id="colCantidad" prefWidth="80.0" text="Cantidad" />
                <TableColumn fx:id="colStockAnterior" prefWidth="80.0" text="Stock Ant." />
                <TableColumn fx:id="colStockNuevo" prefWidth="80.0" text="Stock Nuevo" />
                <TableColumn fx:id="colMotivo" prefWidth="180.0" text="Motivo" />
              </columns>
            </TableView>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Total de movimientos:" />
                  <Label fx:id="lblTotalMovimientos" style="-fx-text-fill: #27AE60; -fx-font-weight: bold;" text="0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </content>
</ScrollPane>