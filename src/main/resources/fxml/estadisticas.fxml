<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" prefHeight="900.0" prefWidth="1400.0">
   
   <!-- Barra superior con título -->
   <top>
      <VBox style="-fx-background-color: #1e3a5f; -fx-padding: 20;">
         <Label text="Dashboard Empresarial" style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;" />
         <Label text="Análisis de ventas, clientes y productos" style="-fx-text-fill: #e8edf2; -fx-font-size: 14px;" />
      </VBox>
   </top>
   
   <!-- Contenido central con gráficas -->
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true">
         <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f5f7fa;">
            
            <!-- Primera fila: Resumen de Ventas y Nuevos Clientes -->
            <HBox spacing="20" prefHeight="320">
               
               <!-- Resumen de Ventas -->
               <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Resumen de Ventas" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <HBox spacing="5" alignment="BASELINE_LEFT">
                     <Label fx:id="lblTotalVentas" text="$8,950.75" style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                     <Label text="USD" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                  </HBox>
                  <Label text="Comparativa Mes anterior" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
                  <AreaChart fx:id="areaChartVentas" legendVisible="false" prefHeight="200">
                     <xAxis>
                        <CategoryAxis label="Semanas" />
                     </xAxis>
                     <yAxis>
                        <NumberAxis label="Ventas" />
                     </yAxis>
                  </AreaChart>
               </VBox>
               
               <!-- Nuevos Clientes -->
               <VBox spacing="10" prefWidth="400" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Nuevos Clientes (Mes)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <Label fx:id="lblNuevosClientes" text="45" style="-fx-font-size: 72px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
                  <Label text="↑ +12% vs mes anterior" style="-fx-font-size: 14px; -fx-text-fill: #27ae60; -fx-font-weight: bold;" />
                  <LineChart fx:id="lineChartClientes" legendVisible="false" prefHeight="120">
                     <xAxis>
                        <CategoryAxis />
                     </xAxis>
                     <yAxis>
                        <NumberAxis />
                     </yAxis>
                  </LineChart>
               </VBox>
               
            </HBox>
            
            <!-- Segunda fila: Ganancias y Costos, Productos Más Vendidos -->
            <HBox spacing="20" prefHeight="320">
               
               <!-- Ganancias y Costos -->
               <VBox spacing="10" prefWidth="400" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Ganancias y Costos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <HBox spacing="5" alignment="BASELINE_LEFT">
                     <Label fx:id="lblGanancias" text="$2,90.05" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
                     <Label text="USD" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
                  </HBox>
                  <VBox spacing="5">
                     <Label text="Ingresos Totales" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
                     <Label text="Costes Operativos" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
                  </VBox>
                  <PieChart fx:id="pieChartGanancias" legendVisible="true" legendSide="RIGHT" prefHeight="180" />
               </VBox>
               
               <!-- Productos Más Vendidos -->
               <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Productos Más Vendidos" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <BarChart fx:id="barChartProductos" legendVisible="false" prefHeight="260">
                     <xAxis>
                        <CategoryAxis label="Productos" />
                     </xAxis>
                     <yAxis>
                        <NumberAxis label="Unidades" />
                     </yAxis>
                  </BarChart>
               </VBox>
               
            </HBox>
            
            <!-- Tercera fila: Ventas por Categoría y Rendimiento Mensual -->
            <HBox spacing="20" prefHeight="320">
               
               <!-- Ventas por Categoría -->
               <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Ventas por Categoría" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <PieChart fx:id="pieChartCategorias" legendVisible="true" legendSide="BOTTOM" prefHeight="260" />
               </VBox>
               
               <!-- Rendimiento Mensual -->
               <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Rendimiento Mensual" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <LineChart fx:id="lineChartRendimiento" legendVisible="true" prefHeight="260">
                     <xAxis>
                        <CategoryAxis label="Meses" />
                     </xAxis>
                     <yAxis>
                        <NumberAxis label="Ventas (miles)" />
                     </yAxis>
                  </LineChart>
               </VBox>
               
            </HBox>
            
            <!-- Cuarta fila: Inventario Crítico y Transacciones Diarias -->
            <HBox spacing="20" prefHeight="320">
               
               <!-- Inventario Crítico -->
               <VBox spacing="10" prefWidth="450" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Inventario Crítico" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <VBox spacing="12" style="-fx-padding: 10 0;">
                     <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="⚠" style="-fx-font-size: 20px; -fx-text-fill: #e74c3c;" />
                        <Label text="Tornillos (Caja):" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                        <Label text="15 und." style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" />
                     </HBox>
                     <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="⚠" style="-fx-font-size: 20px; -fx-text-fill: #e74c3c;" />
                        <Label text="Pintura Blanca (Galón):" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                        <Label text="8 und." style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" />
                     </HBox>
                     <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="⚠" style="-fx-font-size: 20px; -fx-text-fill: #e74c3c;" />
                        <Label text="Sierra Circular:" style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;" />
                        <Label text="3 und." style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />
                     </HBox>
                     <Label text="⚠ Stock Bajo - Requiere reabastecimiento" style="-fx-font-size: 12px; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-padding: 10 0 0 0;" />
                  </VBox>
                  <BarChart fx:id="barChartInventario" legendVisible="false" prefHeight="150">
                     <xAxis>
                        <CategoryAxis />
                     </xAxis>
                     <yAxis>
                        <NumberAxis label="Stock" />
                     </yAxis>
                  </BarChart>
               </VBox>
               
               <!-- Transacciones Diarias -->
               <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                  <Label text="Transacciones Diarias" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                  <Label fx:id="lblTransacciones" text="120" style="-fx-font-size: 56px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
                  <Label text="Ticket Promedio: $75.20" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
                  <AreaChart fx:id="areaChartTransacciones" legendVisible="false" prefHeight="180">
                     <xAxis>
                        <CategoryAxis label="Últimos 7 días" />
                     </xAxis>
                     <yAxis>
                        <NumberAxis />
                     </yAxis>
                  </AreaChart>
               </VBox>
               
            </HBox>
            
            <!-- Panel de controles -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
               <Label text="Panel de Control" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
               <HBox spacing="15" alignment="CENTER_LEFT">
                  <Button text="Actualizar Datos" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;" />
                  <Button text="Exportar PDF" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;" />
                  <Button text="Configuración" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 5;" />
                  <CheckBox text="Auto-actualizar" selected="true" style="-fx-font-size: 14px;" />
               </HBox>
            </VBox>
            
         </VBox>
      </ScrollPane>
   </center>
   
   <!-- Barra inferior -->
   <bottom>
      <HBox style="-fx-background-color: #1e3a5f; -fx-padding: 12;" spacing="30" alignment="CENTER_LEFT">
         <Label text="● Estado: Conectado" style="-fx-text-fill: #27ae60; -fx-font-size: 13px; -fx-font-weight: bold;" />
         <Label text="Última actualización: 31/10/2025 14:30" style="-fx-text-fill: #e8edf2; -fx-font-size: 12px;" />
         <Label fx:id="lblUsuario" text="Usuario: Admin" style="-fx-text-fill: #e8edf2; -fx-font-size: 12px;" />
      </HBox>
   </bottom>
   
</BorderPane>