<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox prefHeight="650" prefWidth="520" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.DialogoUsuarioController">
    
    <!-- HEADER PREMIUM -->
    <VBox style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="24" right="28" bottom="24" left="28"/>
        </padding>
        
        <VBox spacing="4">
            <Label fx:id="lblTitulo" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Nuevo Usuario" />
            <Label fx:id="lblSubtitulo" style="-fx-font-size: 13; -fx-text-fill: #64748b;" text="Complete los datos requeridos del nuevo usuario" />
        </VBox>
    </VBox>
    
    <!-- FORMULARIO -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-style: none;" VBox.vgrow="ALWAYS">
        <VBox spacing="18">
            <padding>
                <Insets top="24" right="28" bottom="24" left="28"/>
            </padding>
            
            <!-- Nombre de Usuario -->
            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1e293b;" text="Nombre de Usuario" />
                <TextField fx:id="txtUsername" promptText="Ej: danieltur" 
                           style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" />
                <Label fx:id="lblErrorUsername" style="-fx-font-size: 11; -fx-text-fill: #dc2626;" visible="false" />
            </VBox>
            
            <!-- Nombre Completo -->
            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1e293b;" text="Nombre Completo" />
                <TextField fx:id="txtNombreCompleto" promptText="Ej: Daniel Turizo" 
                           style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" />
                <Label fx:id="lblErrorNombre" style="-fx-font-size: 11; -fx-text-fill: #dc2626;" visible="false" />
            </VBox>
            
            <!-- Email -->
            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1e293b;" text="Email" />
                <TextField fx:id="txtEmail" promptText="Ej: daniel@stockflow.com" 
                           style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" />
                <Label fx:id="lblErrorEmail" style="-fx-font-size: 11; -fx-text-fill: #dc2626;" visible="false" />
            </VBox>
            
            <!-- Rol -->
            <VBox spacing="8">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1e293b;" text="Rol" />
                <ComboBox fx:id="cmbRol" prefWidth="440" 
                          style="-fx-padding: 10 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-font-size: 12;" />
                
                <VBox spacing="4" style="-fx-padding: 12; -fx-background-color: #f1f5f9; -fx-background-radius: 8;">
                    <Label style="-fx-font-size: 10; -fx-text-fill: #475569; -fx-font-weight: bold;" text="Permisos por Rol:" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #64748b;" text="Admin - Acceso total incluyendo gestión de usuarios" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #64748b;" text="Dueño - Acceso completo excepto gestión de usuarios" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #64748b;" text="Cajero - Acceso limitado a ventas, productos y clientes" />
                </VBox>
            </VBox>
            
            <!-- Separador Visual -->
            <Separator style="-fx-padding: 0; -fx-border-color: #e2e8f0;" />
            
            <!-- Contraseña (solo en modo creación) -->
            <VBox fx:id="vboxPassword" spacing="8">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1e293b;" text="Contraseña" />
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <PasswordField fx:id="txtPassword" promptText="Mínimo 8 caracteres" 
                                   style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" 
                                   HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtPasswordVisible" 
                               style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" 
                               visible="false" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnTogglePassword" onAction="#togglePasswordVisibility" 
                            style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0; -fx-translate-x: -40;">
                        <graphic>
                            <Label fx:id="lblEyeIcon" style="-fx-font-size: 14; -fx-text-fill: #64748b;" text="OJO" />
                        </graphic>
                    </Button>
                </HBox>
                <Label fx:id="lblErrorPassword" style="-fx-font-size: 11; -fx-text-fill: #dc2626;" visible="false" />
            </VBox>
            
            <!-- Confirmar Contraseña (solo en modo creación) -->
            <VBox fx:id="vboxConfirmarPassword" spacing="8">
                <Label style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1e293b;" text="Confirmar Contraseña" />
                <PasswordField fx:id="txtConfirmarPassword" promptText="Repita la contraseña" 
                               style="-fx-padding: 12 14; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-font-size: 12;" />
                <Label fx:id="lblErrorConfirmar" style="-fx-font-size: 11; -fx-text-fill: #dc2626;" visible="false" />
            </VBox>
            
            <!-- Checkbox para cambiar contraseña en modo edición -->
            <CheckBox fx:id="chkCambiarPassword" style="-fx-font-size: 12; -fx-text-fill: #475569; -fx-padding: 0; -fx-font-weight: bold;" text="Cambiar contraseña" visible="false" />
            
        </VBox>
    </ScrollPane>
    
    <!-- BOTONES -->
    <VBox style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <padding>
                <Insets top="20" right="28" bottom="20" left="28"/>
            </padding>
            
            <Button fx:id="btnCancelar" onAction="#handleCancelar" prefWidth="120" 
                    style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;" 
                    text="Cancelar" />
            
            <Button fx:id="btnGuardar" onAction="#handleGuardar" prefWidth="120" 
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;" 
                    text="Guardar" />
        </HBox>
    </VBox>
    
</VBox>