<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="575.0" prefWidth="938.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.Productos_invitadoController">

    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="535.0" prefWidth="898.0" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <children>

                <!-- Panel Superior: Búsqueda Mejorado -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: linear-gradient(to right, #2a5298, #1e3c72); -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 3);">
                    <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                    </padding>
                    <children>
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Buscar Producto" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 2;">
                                    <children>
                                        <Label style="-fx-font-size: 16;" text="🔍">
                                            <padding>
                                                <Insets left="12.0" />
                                            </padding>
                                        </Label>
                                        <TextField fx:id="txtBuscar" prefHeight="42.0" promptText="Buscar Producto por nombre o código..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-prompt-text-fill: #95a5a6;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProducto" prefHeight="42.0" prefWidth="130.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);" text="Buscar" textFill="#2a5298">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <!-- Filtros de Categoría Dinámicos -->
                <HBox fx:id="contenedorFiltros" alignment="CENTER_LEFT" spacing="12.0">
                    <!-- Los botones de categoría se generarán dinámicamente en el controlador -->
                </HBox>

                <!-- Tabla de Productos -->
                <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <Label text="Catálogo de Productos" textFill="#1e3c72">
                                            <font>
                                                <Font name="System Bold" size="18.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblTotalProductos" text="Total: 0 productos" textFill="#95a5a6">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                
                                <!-- Indicador de modo invitado -->
                                <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #FFF3CD; -fx-background-radius: 8; -fx-padding: 8 15 8 15;">
                                    <children>
                                        <Label text="Vista de solo lectura - Modo Invitado" textFill="#856404">
                                            <font>
                                                <Font name="System Bold" size="11.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <TableView fx:id="tablaProductos" prefHeight="350.0" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="120.0" style="-fx-alignment: CENTER-LEFT;" text="Código" />
                                <TableColumn fx:id="colNombre" prefWidth="280.0" style="-fx-alignment: CENTER-LEFT;" text="Nombre" />
                                <TableColumn fx:id="colCategoria" prefWidth="180.0" style="-fx-alignment: CENTER;" text="Categoría" />
                                <TableColumn fx:id="colPrecioVenta" prefWidth="140.0" style="-fx-alignment: CENTER-RIGHT;" text="Precio" />
                                <TableColumn fx:id="colStock" prefWidth="160.0" style="-fx-alignment: CENTER;" text="Disponibilidad" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Botón inferior -->
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio" prefHeight="42.0" prefWidth="140.0" style="-fx-background-color: #6B7C93; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 2);" text="← Volver" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
