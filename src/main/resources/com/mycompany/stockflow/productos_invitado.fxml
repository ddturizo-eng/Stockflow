<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="575.0" prefWidth="938.0" style="-fx-background-color: #F5F7FA;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.stockflow.Productos_invitadoController">

    <children>
        <VBox layoutX="20.0" layoutY="20.0" prefHeight="535.0" prefWidth="898.0" spacing="20.0"
              AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

            <children>

                <!-- Panel Superior: Búsqueda -->
                <HBox alignment="CENTER_LEFT" spacing="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <padding>
                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
                    </padding>
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Buscar Producto" textFill="#1e3c72">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtBuscar" prefHeight="38.0"
                                           promptText="Buscar por nombre, código o categoría..."
                                           style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </TextField>
                            </children>
                        </VBox>

                        <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProducto"
                                prefHeight="38.0" prefWidth="120.0"
                                style="-fx-background-color: #2a5298; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="Buscar" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="13.0"/>
                            </font>
                        </Button>
                    </children>
                </HBox>

                <!-- Tabla de Productos -->
                <VBox spacing="12.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                      VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Catálogo de Productos" textFill="#1e3c72">
                                    <font>
                                        <Font name="System Bold" size="16.0"/>
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="lblTotalProductos" text="Total: 0 productos" textFill="#6B7C93">
                                    <font>
                                        <Font size="13.0"/>
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <TableView fx:id="tablaProductos" prefHeight="350.0"
                                   style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código"/>
                                <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre"/>
                                <TableColumn fx:id="colCategoria" prefWidth="150.0" text="Categoría"/>
                                <TableColumn fx:id="colPrecioVenta" prefWidth="120.0" text="Precio"/>
                                <TableColumn fx:id="colStock" prefWidth="120.0" text="Disponibilidad"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <!-- Botón inferior -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Label text="💡 Vista de solo lectura - Modo Invitado" textFill="#6B7C93">
                                    <font>
                                        <Font name="System Italic" size="11.0"/>
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#volverInicio"
                                        prefHeight="38.0" prefWidth="120.0"
                                        style="-fx-background-color: #E0E6ED; -fx-background-radius: 8; -fx-cursor: hand;"
                                        text="Volver" textFill="#6B7C93">
                                    <font>
                                        <Font name="System Bold" size="13.0"/>
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>
    </children>
</AnchorPane>