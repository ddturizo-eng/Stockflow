<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="575.0" prefWidth="938.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.ClientesController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" prefHeight="535.0" prefWidth="898.0" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <!-- Panel Superior: Búsqueda y Botón Agregar -->
            <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
               </padding>
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Buscar Cliente" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtBuscar" prefHeight="38.0" promptText="Buscar por cédula, nombre o teléfono..." style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarCliente" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #2a5298; -fx-background-radius: 8; -fx-cursor: hand;" text="Buscar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
                  
                  <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#mostrarFormularioAgregar" prefHeight="38.0" prefWidth="160.0" style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-cursor: hand;" text="+ Nuevo Cliente" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
            
            <!-- Tabla de Clientes -->
            <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="Lista de Clientes" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotalClientes" text="Total: 0 clientes" textFill="#6B7C93">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  
                  <TableView fx:id="tablaClientes" prefHeight="350.0" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCedula" prefWidth="120.0" text="Cédula" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono" />
                        <TableColumn fx:id="colEmail" prefWidth="180.0" text="Email" />
                        <TableColumn fx:id="colDireccion" prefWidth="200.0" text="Dirección" />
                        <TableColumn fx:id="colAcciones" prefWidth="100.0" text="Acciones" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
      
      <!-- Formulario Modal -->
      <VBox fx:id="formularioContainer" alignment="CENTER" prefHeight="575.0" prefWidth="938.0" style="-fx-background-color: rgba(0, 0, 0, 0.5);" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox prefHeight="500.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0, 0, 5);">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
               <children>
                  <!-- Título del Formulario -->
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="lblTituloFormulario" text="Agregar Nuevo Cliente" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#cerrarFormulario" style="-fx-background-color: transparent; -fx-cursor: hand;" text="✕" textFill="#6B7C93">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
                  
                  <Separator />
                  
                  <!-- Campos del Formulario -->
                  <GridPane hgap="15.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <!-- Cédula -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <children>
                              <Label text="Cédula *" textFill="#1e3c72">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtCedula" promptText="Ej: 1234567890" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                           </children>
                        </VBox>
                        
                        <!-- Nombre -->
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                           <children>
                              <Label text="Nombre Completo *" textFill="#1e3c72">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtNombre" promptText="Nombre del cliente" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                           </children>
                        </VBox>
                        
                        <!-- Teléfono -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <children>
                              <Label text="Teléfono *" textFill="#1e3c72">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtTelefono" promptText="Ej: 3001234567" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                           </children>
                        </VBox>
                        
                        <!-- Email -->
                        <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                           <children>
                              <Label text="Email" textFill="#1e3c72">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtEmail" promptText="ejemplo@correo.com" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                           </children>
                        </VBox>
                        
                        <!-- Dirección -->
                        <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                           <children>
                              <Label text="Dirección" textFill="#1e3c72">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="txtDireccion" promptText="Dirección completa (opcional)" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>
                  
                  <!-- Botones de Acción -->
                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#cerrarFormulario" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #E0E6ED; -fx-background-radius: 8; -fx-cursor: hand;" text="Cancelar" textFill="#6B7C93">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarCliente" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #27ae60; -fx-background-radius: 8; -fx-cursor: hand;" text="Guardar" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>