<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="1200.0" prefWidth="1200.0" spacing="15.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.VentaController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Nueva Venta" textFill="#1e3c72" />
      
      <HBox spacing="10.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Código de Venta" textFill="#1e3c72" />
                  <TextField fx:id="txtCodigoVenta" editable="false" prefWidth="200.0" text="V-001" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Fecha" textFill="#1e3c72" />
                  <TextField fx:id="txtFecha" editable="false" prefWidth="200.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- MÓDULO 2: BÚSQUEDA DE CLIENTE -->
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Selección de Cliente" textFill="#1e3c72" />
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Buscar Cliente" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtBuscarCliente" prefHeight="38.0" promptText="Buscar por cédula, nombre o teléfono..." style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <VBox alignment="BOTTOM_LEFT">
                     <children>
                        <Button fx:id="btnBuscarCliente" mnemonicParsing="false" onAction="#buscarCliente" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #2a5298; -fx-background-radius: 8;" text="Buscar" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
                  
                  <VBox alignment="BOTTOM_LEFT">
                     <children>
                        <Button fx:id="btnNuevoCliente" mnemonicParsing="false" onAction="#mostrarFormularioCliente" prefHeight="38.0" prefWidth="160.0" style="-fx-background-color: #3498db; -fx-background-radius: 8;" text="+ Nuevo Cliente" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      
      <!-- MÓDULO 3: TABLA DE CLIENTES - AMPLIADA 50% -->
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="Resultados de Búsqueda - Clientes" textFill="#1e3c72">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            
            <TableView fx:id="tablaClientes" prefHeight="250.0" style="-fx-background-radius: 8; -fx-font-size: 13px;">
               <columns>
                  <TableColumn fx:id="colClienteCedula" minWidth="100.0" prefWidth="100.0" text="Cédula" />
                  <TableColumn fx:id="colClienteNombre" minWidth="250.0" prefWidth="280.0" text="Nombre" />
                  <TableColumn fx:id="colClienteTelefono" minWidth="120.0" prefWidth="150.0" text="Teléfono" />
                  <TableColumn fx:id="colClienteEmail" minWidth="200.0" prefWidth="220.0" text="Email" />
                  <TableColumn fx:id="colClienteSeleccionar" minWidth="120.0" prefWidth="130.0" text="Seleccionar" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Cliente Seleccionado:" textFill="#1e3c72">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblClienteSeleccionado" text="Ninguno" textFill="#27ae60">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
      
      <!-- MÓDULO 4: BÚSQUEDA DE PRODUCTOS -->
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Agregar Productos a la Venta" textFill="#1e3c72" />
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Buscar Producto" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtBuscarProducto" prefHeight="38.0" promptText="Buscar por código, nombre o categoría..." style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Cantidad" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtCantidad" prefHeight="38.0" prefWidth="80.0" promptText="1" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" text="1">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Descuento" textFill="#1e3c72">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtDescuento" prefHeight="38.0" prefWidth="80.0" promptText="0.00" style="-fx-background-radius: 8; -fx-border-color: #E0E6ED; -fx-border-radius: 8; -fx-border-width: 1.5;" text="0">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
                  
                  <VBox alignment="BOTTOM_LEFT">
                     <children>
                        <Button fx:id="btnBuscarProducto" mnemonicParsing="false" onAction="#buscarProducto" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #2a5298; -fx-background-radius: 8;" text="Buscar" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
      
      <!-- MÓDULO 5: TABLA DE PRODUCTOS - AMPLIADA 50% -->
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="Resultados de Búsqueda - Productos" textFill="#1e3c72">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            
            <TableView fx:id="tablaProductos" prefHeight="300.0" minHeight="150.0" maxHeight="400.0" style="-fx-background-radius: 8;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colProductoCodigo" prefWidth="100.0" text="Código" />
                  <TableColumn fx:id="colProductoNombre" prefWidth="350.0" text="Nombre" />
                  <TableColumn fx:id="colProductoCategoria" prefWidth="180.0" text="Categoría" />
                  <TableColumn fx:id="colProductoPrecio" prefWidth="130.0" text="Precio" />
                  <TableColumn fx:id="colProductoStock" prefWidth="100.0" text="Stock" />
                  <TableColumn fx:id="colProductoAgregar" prefWidth="130.0" text="Agregar" />
               </columns>
            </TableView>
         </children>
      </VBox>
      
      <!-- MÓDULO 6: DETALLE DE VENTA -->
      <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Detalle de Venta" textFill="#1e3c72" />
      
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button onAction="#eliminarProductoSeleccionado" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 8;" text="- Eliminar Seleccionado">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </HBox>
      
      <TableView fx:id="tblDetalleVenta" prefHeight="200.0" style="-fx-background-radius: 8;">
        <columns>
          <TableColumn fx:id="colNumero" prefWidth="40.0" text="#" />
          <TableColumn fx:id="colProducto" prefWidth="250.0" text="Producto" />
            <TableColumn fx:id="colCantidad" prefWidth="100.0" text="Cantidad" />
            <TableColumn fx:id="colDescuento" prefWidth="100.0" text="Descuento" />
            <TableColumn fx:id="colSubtotal" prefWidth="210.0" text="Subtotal" />
        </columns>
      </TableView>
      
      <!-- MÓDULO 7: RESUMEN -->
      <HBox spacing="5.0">
         <children>
            <Label text="IVA (%):" textFill="#1e3c72" />
            <TextField fx:id="txtIVA" prefWidth="60.0" text="16" />
            <Label fx:id="lblTotalPagar" style="-fx-font-size: 14; -fx-font-weight: bold;" text="TOTAL A PAGAR: $0.00" textFill="#1e3c72" />
         </children>
      </HBox>
      
      <!-- MÓDULO 8: MÉTODO DE PAGO -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Método de Pago" textFill="#1e3c72" />
                  <ComboBox fx:id="cmbMetodoPago" prefWidth="150.0" promptText="Efectivo / Tarjeta" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Monto Recibido" textFill="#1e3c72" />
                  <TextField fx:id="txtMontoRecibido" prefWidth="100.0" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Cambio" textFill="#1e3c72" />
                  <TextField fx:id="txtCambio" editable="false" prefWidth="100.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <!-- MÓDULO 9: BOTONES FINALES -->
      <HBox alignment="CENTER_RIGHT" spacing="20.0">
         <children>
            <Button fx:id="btnCancelarVenta" text="Cancelar Venta" />
            <Button fx:id="btnGuardarVenta" onAction="#guardarVenta" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="GUARDAR VENTA Y FACTURAR" />
         </children>
      </HBox>
   </children>
</VBox>