<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="480.0" minWidth="640.0" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #1e3c72, #2a5298, #7e8ba3);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.stockflow.BienvenidaController">
   <children>
      <!-- Partículas de fondo animadas - RESPONSIVE -->
      <Canvas fx:id="canvasParticulas" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
      
      <!-- Contenedor principal centrado con efecto glassmorphism mejorado - RESPONSIVE -->
      <StackPane maxHeight="560.0" maxWidth="850.0" minHeight="450.0" minWidth="600.0" prefHeight="520.0" prefWidth="800.0" style="-fx-background-color: rgba(30, 45, 70, 0.85); -fx-background-radius: 30; -fx-border-color: rgba(79, 195, 247, 0.25); -fx-border-width: 2; -fx-border-radius: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 40, 0.4, 0, 15);" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0" AnchorPane.topAnchor="100.0">
         <children>
            <VBox alignment="CENTER" spacing="30.0" StackPane.alignment="CENTER">
               <children>
                  <!-- Logo StockFlow con icono mejorado -->
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <!-- Icono con círculo de fondo -->
                        <StackPane>
                           <SVGPath content="M20 10 L30 5 L40 10 L30 15 Z M30 15 L40 20 L30 25 L20 20 Z" fill="#4FC3F7" scaleX="1.3" scaleY="1.3">
                              <effect>
                                 <DropShadow color="#00bcd4" height="20.0" radius="10.0" width="20.0" />
                              </effect>
                           </SVGPath>
                        </StackPane>
                        
                        <HBox fx:id="contenedorLetras" alignment="CENTER" spacing="3.0">
                           <children>
                              <Label fx:id="letra_S" text="Stock" textFill="WHITE">
                                 <font>
                                    <Font name="System Bold" size="52.0" />
                                 </font>
                              </Label>
                              <Label fx:id="letra_F" text="Flow" textFill="#4FC3F7">
                                 <font>
                                    <Font name="System Bold" size="52.0" />
                                 </font>
                                 <effect>
                                    <DropShadow color="#00bcd4" height="15.0" radius="7.0" width="15.0" />
                                 </effect>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                     <effect>
                        <DropShadow color="rgba(0,0,0,0.7)" height="12.0" radius="6.0" width="12.0" />
                     </effect>
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </HBox>
                  
                  <!-- Subtítulo del sistema -->
                  <Label text="Sistema de Gestión de Inventario" textFill="rgba(255,255,255,0.7)">
                     <font>
                        <Font name="System" size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="-15.0" />
                     </VBox.margin>
                  </Label>
                  
                  <!-- Canvas para animación de ondas -->
                  <StackPane maxWidth="650.0" minWidth="400.0" prefHeight="100.0" prefWidth="600.0">
                     <children>
                        <Canvas fx:id="canvasOndas" height="100.0" width="600.0" />
                     </children>
                  </StackPane>
                  
                  <!-- Título BIENVENIDO con estilo mejorado -->
                  <VBox alignment="CENTER" spacing="8.0">
                     <children>
                        <Label fx:id="lblBienvenido" text="BIENVENIDO" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="36.0" />
                           </font>
                           <effect>
                              <DropShadow color="rgba(79, 195, 247, 0.6)" height="10.0" radius="5.0" width="10.0" />
                           </effect>
                        </Label>
                        <Label text="Selecciona tu modo de acceso" textFill="rgba(255,255,255,0.6)">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </VBox>
                  
                  <!-- Botones en vertical con mejor diseño - CENTRADOS -->
                  <VBox alignment="CENTER" maxWidth="380.0" minWidth="300.0" spacing="18.0">
                     <children>
                        <!-- Botón Iniciar Sesión (Administrador) con icono -->
                        <Button fx:id="btnAdministrador" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#iniciarComoAdministrador" prefHeight="60.0" style="-fx-background-color: linear-gradient(to right, #00bcd4, #0097a7); -fx-background-radius: 30; -fx-border-color: rgba(255,255,255,0.4); -fx-border-width: 2; -fx-border-radius: 30; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,188,212,0.5), 20, 0.5, 0, 5);">
                           <graphic>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <Label text="INICIAR SESIÓN" textFill="WHITE">
                                       <font>
                                          <Font name="System Bold" size="16.0" />
                                       </font>
                                       <graphic>
                                          <ImageView fitHeight="32.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                             <image>
                                                <Image url="@IMG/gerente.png" />
                                             </image>
                                          </ImageView>
                                       </graphic>
                                    </Label>
                                 </children>
                              </HBox>
                           </graphic>
                        </Button>
                        
                        <!-- Botón Iniciar como Invitado con diseño outline -->
                        <Button fx:id="btnInvitado" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#iniciarComoInvitado" prefHeight="60.0" style="-fx-background-color: transparent; -fx-background-radius: 30; -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 2.5; -fx-border-radius: 30; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;">
                           <graphic>
                              <HBox alignment="CENTER" spacing="10.0">
                                 <children>
                                    <ImageView fitHeight="32.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@IMG/agregar-usuario%20(2).png" />
                                       </image>
                                    </ImageView>
                                    <Label text="MODO INVITADO" textFill="WHITE">
                                       <font>
                                          <Font name="System Bold" size="16.0" />
                                       </font>
                                    </Label>
                                 </children>
                              </HBox>
                           </graphic>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="35.0" left="50.0" right="50.0" top="35.0" />
               </padding>
            </VBox>
         </children>
      </StackPane>
      
      <!-- Footer mejorado con indicador de teclado -->
      <HBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Label fx:id="footer" text="Presiona F11 para pantalla completa" textFill="rgba(255,255,255,0.5)">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Label text="•" textFill="rgba(255,255,255,0.3)">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Label text="ESC para salir de pantalla completa" textFill="rgba(255,255,255,0.5)">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </children>
</AnchorPane>
